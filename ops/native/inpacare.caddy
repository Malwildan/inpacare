https://inpacare.hailmary.my.id {
	bind ::
	tls "/home/malwildan/.local/share/mac-cloud-drive/acme/certificates/inpacare.hailmary.my.id.crt" "/home/malwildan/.local/share/mac-cloud-drive/acme/certificates/inpacare.hailmary.my.id.key"
	encode zstd gzip
	@pgadmin path /db /db/*
	handle @pgadmin {
		reverse_proxy 127.0.0.1:5050 {
			header_up X-Script-Name /db
			header_up X-Scheme {scheme}
			trusted_proxies 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 131.0.72.0/22 141.101.64.0/18 162.158.0.0/15 172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 190.93.240.0/20 197.234.240.0/22 198.41.128.0/17 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		}
	}
	# This loopback listener fixes the external scheme to HTTPS for secure sessions.
	reverse_proxy 127.0.0.1:8089 {
		header_up Host {host}
	}
}

http://inpacare.hailmary.my.id {
	bind ::
	redir https://{host}{uri} 308
}
