[Unit]
Description=InpaCare Rust API
Requires=inpacare-db.service
After=inpacare-db.service

[Service]
Type=simple
ExecStart=/bin/bash "@ROOT@/scripts/native-host.sh" run-api
Restart=on-failure
RestartSec=3
WorkingDirectory=@ROOT@
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
